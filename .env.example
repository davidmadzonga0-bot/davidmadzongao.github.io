# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Gmail IMAP (requires 2FA + app password from https://myaccount.google.com/apppasswords)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
EMAIL_POLL_SECONDS=120
EMAIL_MARK_SEEN=false

# OpenAI reasoning (optional but recommended)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Storage
AGENTS_DB_PATH=data/agents.sqlite3

# Runtime
WORKER_POLL_SECONDS=3
# Optional daily Telegram summary hour in UTC (0-23). Leave blank to disable.
DAILY_REPORT_HOUR=8
